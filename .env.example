# CodeReviewGraph Environment Configuration
# Default LLM Provider: 'mock' (offline rule-based engine) or 'gemini' (live Google Gemini)
LLM_PROVIDER=mock

# Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# API Server Host and Port
API_HOST=127.0.0.1
API_PORT=8000

# SQLite Checkpoint Database Path
SQLITE_DB_PATH=codereviewgraph_checkpoints.db
